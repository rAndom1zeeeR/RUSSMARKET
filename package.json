{
  "name": "shift-schedule",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "check": "pnpm lint:check && pnpm format:check && pnpm knip && pnpm test:coverage",
    "db:generate": "prisma generate --schema prisma/schema.prisma && prisma generate --schema prisma/postgres/schema.prisma",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reseed": "prisma db seed -- --force",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "db:setup": "pnpm db:generate && prisma migrate deploy && prisma db seed",
    "postinstall": "pnpm db:generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report"
  },
  "knip": {
    "ignoreDependencies": [
      "@prisma/client"
    ],
    "ignore": [
      "tests/stubs/server-only.ts"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "^7.10.1",
    "@tanstack/react-query": "^5.108.1",
    "@tanstack/react-virtual": "^3.14.26",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "^31.0.1",
    "knip": "^6.46.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-plugin-security-rules": "^0.2.0",
    "oxlint-tsgolint": "^7.0.2007",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
