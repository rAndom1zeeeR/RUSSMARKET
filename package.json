{
  "name": "nextjs-base",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "check": "pnpm lint:check && pnpm format:check && pnpm knip",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "db:setup": "prisma generate && prisma migrate deploy && prisma db seed",
    "postinstall": "prisma generate"
  },
  "knip": {
    "ignoreDependencies": [
      "@prisma/client"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
