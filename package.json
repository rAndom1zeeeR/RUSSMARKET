    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "knip": "^6.46.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-plugin-security-rules": "^0.2.0",
    "oxlint-tsgolint": "^7.0.2007",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2"
