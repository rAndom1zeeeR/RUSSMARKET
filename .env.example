# Какая база — решает схема URL: file:… → SQLite (только локальная разработка), postgresql://… → Postgres (прод).
# NODE_ENV здесь не задаём: Next выставляет его сам (dev / build / start).
DATABASE_URL="file:./prisma/data/dev.db"
# DATABASE_URL="postgresql://user:password@host:5432/dbname"
PORT=3000
